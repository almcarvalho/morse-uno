
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

// =====================================
// PINOS
// =====================================

#define BOTAO 2
#define BUZZER 8

// =====================================
// CONFIGURACOES DE TEMPO
// =====================================

// Ponto: menos de 500 ms
// Traco: 500 ms ou mais
const unsigned long TEMPO_TRACO = 500;

// Espera 2 segundos para finalizar letra
const unsigned long PAUSA_LETRA = 2000;

// Espaco entre palavras no modo livre
const unsigned long PAUSA_PALAVRA = 4500;

// Limpa digitacao livre apos 60 segundos
const unsigned long TEMPO_LIMPEZA = 60000;

// Debounce do botao
const unsigned long DEBOUNCE = 25;

// Menu inicia apos 3 segundos parado
const unsigned long ESPERA_MENU = 3000;

// Segurar por 4 segundos encerra o modo
const unsigned long TEMPO_SAIR = 4000;

// Tempo das mensagens de erro e acerto
const unsigned long TEMPO_MENSAGEM = 2500;

// =====================================
// PALAVRAS DE 3 A 5 LETRAS
// =====================================

const char* palavras[] = {
  "SOL", "MAR", "PAZ", "LUZ", "RIO",
  "CASA", "GATO", "PATO", "BOLA", "VIDA",
  "AMOR", "LUA", "SOM", "FLOR", "FOGO",
  "RADIO", "MORSE", "LIVRO", "CARRO",
  "NUVEM", "TEMPO", "PRAIA", "PEDRA",
  "VENTO", "NOITE", "PORTA", "MUNDO",
  "PONTE", "TERRA", "CAMPO"
};

const int TOTAL_PALAVRAS =
  sizeof(palavras) / sizeof(palavras[0]);

// =====================================
// TABELA MORSE
// =====================================

const char* tabelaMorse[] = {
  ".-", "-...", "-.-.", "-..", ".", "..-.",
  "--.", "....", "..", ".---", "-.-", ".-..",
  "--", "-.", "---", ".--.", "--.-", ".-.",
  "...", "-", "..-", "...-", ".--", "-..-",
  "-.--", "--..",

  "-----", ".----", "..---", "...--", "....-",
  ".....", "-....", "--...", "---..", "----."
};

const char tabelaLetras[] =
  "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";

// =====================================
// ESTADOS DO PROGRAMA
// =====================================

enum Estado {
  JOGANDO,
  MOSTRANDO_DICA,
  MOSTRANDO_RESULTADO,
  PLACAR_FINAL
};

Estado estado = JOGANDO;

byte modo = 1;
bool menuAtivo = true;

unsigned long ultimaInteracaoMenu = 0;
unsigned long inicioMensagem = 0;

// =====================================
// CONTROLE DO BOTAO
// =====================================

bool botaoPressionado = false;
bool leituraAnterior = false;
bool saidaExecutada = false;

unsigned long ultimaMudanca = 0;
unsigned long inicioPressao = 0;
unsigned long fimPressao = 0;

// =====================================
// MORSE
// =====================================

String codigo = "";
String historico = "";

bool letraPendente = false;
bool espacoInserido = false;

unsigned long ultimaAtividade = 0;

// =====================================
// TREINAMENTO
// =====================================

String palavra = "";
String digitado = "";

byte posicao = 0;
int ultimaPalavra = -1;

unsigned int acertos = 0;
unsigned int erros = 0;

// =====================================
// NUMEROS
// =====================================

char numeroAtual = '0';
char ultimoNumero = 'X';

// =====================================
// BUZZER
// =====================================

bool bipAtivo = false;
unsigned long fimBip = 0;

// =====================================
// FUNCOES DO LCD
// =====================================

void linhaLCD(byte linha, String texto) {
  lcd.setCursor(0, linha);
  lcd.print("                ");
  lcd.setCursor(0, linha);
  lcd.print(texto.substring(0, 16));
}

void mostrarMenu() {
  String nome;

  switch (modo) {
    case 1:
      nome = "DIGITAR";
      break;

    case 2:
      nome = "TREINO";
      break;

    case 3:
      nome = "DESAFIO";
      break;

    case 4:
      nome = "NUMBERS";
      break;
  }

  linhaLCD(0, "MODO " + String(modo) + " " + nome);
  linhaLCD(1, "AUTO EM 3 SEG");
}

void mostrarJogo() {
  if (menuAtivo || estado != JOGANDO) {
    return;
  }

  // MODO 1
  if (modo == 1) {
    linhaLCD(0, historico);

    if (codigo.length() > 0) {
      linhaLCD(1, "MORSE: " + codigo);
    } else {
      linhaLCD(1, "Aguardando...");
    }
  }

  // MODO 4
  else if (modo == 4) {
    linhaLCD(0, "NUMERO: " + String(numeroAtual));

    if (codigo.length() > 0) {
      linhaLCD(1, "MORSE: " + codigo);
    } else {
      linhaLCD(1, "Digite Morse");
    }
  }

  // MODOS 2 E 3
  else {
    linhaLCD(0, palavra);

    String linha = digitado;

    if (codigo.length() > 0) {
      linha += " ";
      linha += codigo;
    }

    linhaLCD(1, linha);
  }
}

// =====================================
// BUZZER
// =====================================

void beep(int frequencia, unsigned long duracao) {
  tone(BUZZER, frequencia);

  bipAtivo = true;
  fimBip = millis() + duracao;
}

void atualizarBeep(unsigned long agora) {
  if (bipAtivo &&
      (long)(agora - fimBip) >= 0) {

    bipAtivo = false;

    if (!botaoPressionado) {
      noTone(BUZZER);
    }
  }
}

// =====================================
// TRADUTOR MORSE
// =====================================

char traduzir(String codigoMorse) {
  for (int i = 0; i < 36; i++) {
    if (codigoMorse == tabelaMorse[i]) {
      return tabelaLetras[i];
    }
  }

  return '?';
}

String dicaMorse(char letra) {
  for (int i = 0; i < 36; i++) {
    if (letra == tabelaLetras[i]) {
      return String(tabelaMorse[i]);
    }
  }

  return "?";
}

// =====================================
// NOVA PALAVRA
// =====================================

void novaPalavra() {
  int indice;

  do {
    indice = random(TOTAL_PALAVRAS);
  } while (
    TOTAL_PALAVRAS > 1 &&
    indice == ultimaPalavra
  );

  ultimaPalavra = indice;

  palavra = palavras[indice];

  digitado = "";
  posicao = 0;

  codigo = "";
  letraPendente = false;

  estado = JOGANDO;

  mostrarJogo();

  Serial.print("PALAVRA: ");
  Serial.println(palavra);
}

// =====================================
// NOVO NUMERO
// =====================================

void novoNumero() {
  char novo;

  do {
    novo = '0' + random(10);
  } while (novo == ultimoNumero);

  ultimoNumero = novo;
  numeroAtual = novo;

  codigo = "";
  letraPendente = false;

  estado = JOGANDO;

  mostrarJogo();

  Serial.print("NUMERO: ");
  Serial.println(numeroAtual);
}

// =====================================
// MENU
// =====================================

void voltarMenu() {
  menuAtivo = true;
  modo = 1;

  estado = JOGANDO;

  codigo = "";
  historico = "";
  digitado = "";

  letraPendente = false;
  espacoInserido = false;

  ultimaInteracaoMenu = millis();

  beep(1200, 150);

  mostrarMenu();
}

void mostrarPlacar() {
  estado = PLACAR_FINAL;

  codigo = "";
  letraPendente = false;

  noTone(BUZZER);
  bipAtivo = false;

  linhaLCD(0, "DESAFIO ENCERR.");
  linhaLCD(
    1,
    "A:" + String(acertos) +
    " E:" + String(erros)
  );

  Serial.println("=== PLACAR FINAL ===");

  Serial.print("ACERTOS: ");
  Serial.println(acertos);

  Serial.print("ERROS: ");
  Serial.println(erros);
}

void selecionarModo() {
  menuAtivo = false;
  estado = JOGANDO;

  codigo = "";
  historico = "";
  digitado = "";

  letraPendente = false;
  espacoInserido = false;

  ultimaAtividade = millis();

  acertos = 0;
  erros = 0;

  beep(1700, 180);

  if (modo == 1) {
    mostrarJogo();
  }
  else if (modo == 4) {
    novoNumero();
  }
  else {
    novaPalavra();
  }
}

// =====================================
// MODO 1 - DIGITACAO LIVRE
// =====================================

void modoDigitacao(char letra) {
  if (historico.length() >= 16) {
    historico = "";
  }

  historico += letra;

  ultimaAtividade = millis();
  espacoInserido = false;

  mostrarJogo();
}

// =====================================
// MODO 2 - TREINO
// =====================================

void modoTreino(char letra) {
  char correta = palavra[posicao];

  if (letra == correta) {
    digitado += letra;
    posicao++;

    beep(1500, 120);

    if (posicao >= palavra.length()) {
      estado = MOSTRANDO_RESULTADO;
      inicioMensagem = millis();

      linhaLCD(0, "PARABENS!");
      linhaLCD(1, palavra);
    }
    else {
      mostrarJogo();
    }
  }
  else {
    estado = MOSTRANDO_DICA;
    inicioMensagem = millis();

    beep(300, 300);

    linhaLCD(
      0,
      "ERRO! LETRA: " + String(correta)
    );

    linhaLCD(
      1,
      "DICA: " + dicaMorse(correta)
    );
  }
}

// =====================================
// MODO 3 - DESAFIO
// =====================================

void modoDesafio(char letra) {
  char correta = palavra[posicao];

  if (letra == correta) {
    digitado += letra;
    posicao++;

    if (posicao >= palavra.length()) {
      acertos++;

      estado = MOSTRANDO_RESULTADO;
      inicioMensagem = millis();

      beep(1800, 250);

      linhaLCD(0, "PALAVRA CERTA!");

      linhaLCD(
        1,
        "A:" + String(acertos) +
        " E:" + String(erros)
      );
    }
    else {
      beep(1500, 100);
      mostrarJogo();
    }
  }
  else {
    erros++;

    estado = MOSTRANDO_RESULTADO;
    inicioMensagem = millis();

    beep(300, 350);

    linhaLCD(0, "ERRO: " + palavra);

    linhaLCD(
      1,
      "A:" + String(acertos) +
      " E:" + String(erros)
    );
  }
}

// =====================================
// MODO 4 - NUMBERS
// =====================================

void modoNumbers(char letra) {
  if (letra == numeroAtual) {
    estado = MOSTRANDO_RESULTADO;
    inicioMensagem = millis();

    beep(1800, 250);

    linhaLCD(0, "NUMERO CORRETO!");

    linhaLCD(
      1,
      String(numeroAtual) +
      " = " + dicaMorse(numeroAtual)
    );
  }
  else {
    estado = MOSTRANDO_DICA;
    inicioMensagem = millis();

    beep(300, 300);

    linhaLCD(
      0,
      "ERRO! NUM: " + String(numeroAtual)
    );

    linhaLCD(
      1,
      "DICA: " + dicaMorse(numeroAtual)
    );
  }
}

// =====================================
// PROCESSAR LETRA
// =====================================

void processarLetra(char letra) {
  Serial.print("RECEBIDO: ");
  Serial.println(letra);

  switch (modo) {
    case 1:
      modoDigitacao(letra);
      break;

    case 2:
      modoTreino(letra);
      break;

    case 3:
      modoDesafio(letra);
      break;

    case 4:
      modoNumbers(letra);
      break;
  }
}

// =====================================
// CONTROLE DO BOTAO
// =====================================

void aoPressionar(unsigned long agora) {
  inicioPressao = agora;
  saidaExecutada = false;

  if (!menuAtivo && estado == JOGANDO) {
    bipAtivo = false;
    tone(BUZZER, 900);
  }
}

void aoSoltar(unsigned long agora) {
  unsigned long duracao =
    agora - inicioPressao;

  noTone(BUZZER);
  bipAtivo = false;

  // MENU
  if (menuAtivo) {
    modo++;

    if (modo > 4) {
      modo = 1;
    }

    ultimaInteracaoMenu = agora;

    beep(1100, 100);
    mostrarMenu();

    return;
  }

  // NAO REGISTRAR O PULSO DE SAIDA
  if (saidaExecutada) {
    return;
  }

  // PLACAR FINAL
  if (estado == PLACAR_FINAL) {
    voltarMenu();
    return;
  }

  if (estado != JOGANDO) {
    return;
  }

  if (duracao < 40) {
    return;
  }

  // SEGURANCA: PULSO LONGO
  if (duracao >= TEMPO_SAIR) {
    return;
  }

  // REGISTRAR PONTO OU TRACO
  if (duracao < TEMPO_TRACO) {
    codigo += ".";
  }
  else {
    codigo += "-";
  }

  fimPressao = agora;
  letraPendente = true;
  espacoInserido = false;

  Serial.print("MORSE: ");
  Serial.println(codigo);

  mostrarJogo();
}

void lerBotao(unsigned long agora) {
  bool leitura =
    digitalRead(BOTAO) == LOW;

  if (leitura != leituraAnterior) {
    ultimaMudanca = agora;
  }

  if (
    agora - ultimaMudanca >= DEBOUNCE &&
    leitura != botaoPressionado
  ) {
    botaoPressionado = leitura;

    if (botaoPressionado) {
      aoPressionar(agora);
    }
    else {
      aoSoltar(agora);
    }
  }

  leituraAnterior = leitura;

  // SEGURAR 4 SEGUNDOS PARA SAIR
  if (
    !menuAtivo &&
    botaoPressionado &&
    !saidaExecutada &&
    agora - inicioPressao >= TEMPO_SAIR
  ) {
    saidaExecutada = true;

    noTone(BUZZER);
    bipAtivo = false;

    if (modo == 3) {
      mostrarPlacar();
    }
    else {
      voltarMenu();
    }
  }
}

// =====================================
// PROCESSAR PAUSAS MORSE
// =====================================

void processarPausas(unsigned long agora) {
  if (menuAtivo) return;
  if (estado != JOGANDO) return;
  if (botaoPressionado) return;

  if (
    letraPendente &&
    codigo.length() > 0 &&
    agora - fimPressao >= PAUSA_LETRA
  ) {
    char letra = traduzir(codigo);

    Serial.print("CODIGO: ");
    Serial.print(codigo);

    Serial.print(" -> ");
    Serial.println(letra);

    codigo = "";
    letraPendente = false;

    processarLetra(letra);
  }

  // ESPACO AUTOMATICO SOMENTE MODO 1
  if (
    modo == 1 &&
    historico.length() > 0 &&
    !espacoInserido &&
    agora - fimPressao >= PAUSA_PALAVRA
  ) {
    if (
      historico.length() < 16 &&
      historico[historico.length() - 1] != ' '
    ) {
      historico += " ";
    }

    espacoInserido = true;
    mostrarJogo();
  }
}

// =====================================
// TELAS DE RESULTADO
// =====================================

void processarMensagens(unsigned long agora) {
  if (
    estado != MOSTRANDO_DICA &&
    estado != MOSTRANDO_RESULTADO
  ) {
    return;
  }

  if (
    agora - inicioMensagem < TEMPO_MENSAGEM
  ) {
    return;
  }

  if (estado == MOSTRANDO_DICA) {
    // REPETIR A MESMA LETRA OU NUMERO
    estado = JOGANDO;

    codigo = "";
    letraPendente = false;

    mostrarJogo();
  }
  else {
    if (modo == 4) {
      novoNumero();
    }
    else {
      novaPalavra();
    }
  }
}

// =====================================
// SETUP
// =====================================

void setup() {
  Serial.begin(9600);

  pinMode(BOTAO, INPUT_PULLUP);
  pinMode(BUZZER, OUTPUT);

  lcd.init();
  lcd.backlight();

  randomSeed(analogRead(A0));

  linhaLCD(0, "MORSE TRAINER");
  linhaLCD(1, "4 MODOS");

  delay(1500);

  ultimaInteracaoMenu = millis();

  mostrarMenu();
}

// =====================================
// LOOP
// =====================================

void loop() {
  unsigned long agora = millis();

  lerBotao(agora);
  atualizarBeep(agora);

  // MENU AUTOMATICO APOS 3 SEGUNDOS
  if (
    menuAtivo &&
    !botaoPressionado &&
    agora - ultimaInteracaoMenu >= ESPERA_MENU
  ) {
    selecionarModo();
  }

  processarPausas(agora);
  processarMensagens(agora);

  // LIMPEZA AUTOMATICA NO MODO 1
  if (
    !menuAtivo &&
    modo == 1 &&
    historico.length() > 0 &&
    agora - ultimaAtividade >= TEMPO_LIMPEZA
  ) {
    historico = "";
    espacoInserido = true;

    mostrarJogo();
  }

  delay(5);
}
